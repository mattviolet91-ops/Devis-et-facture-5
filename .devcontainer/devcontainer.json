{
    "name": "Gestion artisan (démonstration)",
    "build": { "dockerfile": "Dockerfile" },
    "forwardPorts": [8000],
    "portsAttributes": {
        "8000": { "label": "Application", "onAutoForward": "openBrowser" }
    },
    "postCreateCommand": "bash .devcontainer/preparer.sh",
    "postAttachCommand": "bash .devcontainer/lancer.sh",
    "customizations": {
        "codespaces": { "openFiles": ["README.md"] }
    }
}
